<% cache ['chapters-sidebar', title, I18n.locale, :v2], skip_digest: true, expires_in: 10.minutes do %>
  <% if title %>
    <h3><%= title %></h3>
  <% end %>
  <ul class="list-unstyled ms-0">
    <% chapters.each do |chapter| %>
      <li>
        <%= link_to chapter.name, chapter_path(chapter.slug) %>
      </li>
    <% end %>
  </ul>
<% end %>
