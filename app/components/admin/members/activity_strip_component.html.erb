<%# app/components/admin/members/activity_strip_component.html.erb %>
<div class="activity-strip">
  <h5>Activity — last 12 months</h5>
  <svg viewBox="0 0 <%= svg_width %> <%= STRIP_HEIGHT %>" width="100%" height="<%= STRIP_HEIGHT %>"
       style="overflow: visible" role="img" aria-label="Weekly activity, last 12 months">
    <% weeks.each_with_index do |week, i| %>
      <rect x="<%= i * (CELL_WIDTH + CELL_GAP) %>" y="0"
            width="<%= CELL_WIDTH %>" height="<%= STRIP_HEIGHT %>" rx="2"
            class="activity-cell activity-cell-<%= week.state %>"
            aria-label="<%= iso_week(week) %>">
        <title><%= title_for(week) %></title>
      </rect>
    <% end %>
    <% if tracking_start_index %>
      <line x1="<%= marker_x %>" y1="<%= -(marker_overflow) %>"
            x2="<%= marker_x %>" y2="<%= STRIP_HEIGHT + marker_overflow %>"
            stroke-width="<%= MARKER_STROKE_WIDTH %>"
            class="activity-tracking-start" aria-hidden="true">
      </line>
      <rect x="<%= marker_hit_x %>" y="<%= -(marker_overflow) %>"
            width="<%= MARKER_HIT_WIDTH %>" height="<%= MARKER_HEIGHT %>"
            fill="transparent" pointer-events="all"
            class="activity-tracking-start-hit">
        <title><%= marker_title %></title>
      </rect>
    <% end %>
  </svg>
</div>
