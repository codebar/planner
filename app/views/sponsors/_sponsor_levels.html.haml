- ['gold', 'silver', 'bronze', 'community', 'standard'].each do |level|
  - if sponsor_levels[level]
    .py-4.py-lg-5.bg-light
      .container
        .row
          .col
            %h3.text-center
              = sponsorship_level_title(level)
        = render partial: 'shared/sponsors', object: sponsor_levels[level].compact
