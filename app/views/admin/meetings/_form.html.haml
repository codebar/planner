- content_for :head do
  %link{ href: '/tom-select/tom-select.bootstrap5.min.css', rel: 'stylesheet', type: 'text/css' }
  %script{ src: '/tom-select/tom-select.complete.min.js' }
  = javascript_include_tag 'admin/tom-select-init'

= simple_form_for [:admin, @meeting] do |f|
  .row
    .col-12
      = f.input :name, required: true
    .col-12.col-md-6
      = f.input :slug, required: true
    .col-12.col-md-6
      = f.input :local_date, required: true, input_html: { value: @meeting.date_and_time.try(:strftime, '%Y-%m-%d'), type: :date }
    .col-12.col-md-6
      = f.input :local_time, label: 'Starts at', required: true, input_html: { value: @meeting.time.try(:strftime, '%H:%M'), type: :time }
    .col-12.col-md-6
      = f.input :local_end_time, label: 'Ends at', required: true, input_html: { value: @meeting.ends_at.try(:strftime, '%H:%M'), type: :time }
    .col-12
      = f.input :description, placeholder: 'Supports HTML', as: :text, input_html: { rows: 5 }
    .col-12
      = f.input :spaces, as: :integer
    .col-12
      = f.association :venue, input_html: { data: { placeholder: 'Select venue' }}, required: true
    .col-12
      = f.label :organisers
      = f.select :organisers,
                 options_for_select(@meeting.organisers.map { |o| [o.full_name, o.id] }, @meeting.organisers.map(&:id)),
                 { include_blank: false },
                 { multiple: true, class: 'tom-select', data: { placeholder: 'Type to search members...' } }
    .col-12
      = f.input :chapters, collection: Chapter.all, label_method: :name, value_method: :id, selected: @meeting.chapters.map(&:id), input_html: { multiple: true }
    .col-12
      = f.input :invitable, as: :boolean, hint: 'Allow members to RSVP', hint_html: { class: 'ms-1' }
    .text-right
      = f.button :button, 'Save', class: 'btn btn-primary'
