.container.py-4
  %h1= t('admin.chapter_contacts.title', chapter: @chapter.name)

  - if flash[:alert]
    .alert.alert-danger= flash[:alert]

  = form_with scope: :chapter_contact, url: preview_admin_chapter_contact_path(@chapter) do |form|
    %p{ data: { chapter_contact_recipient_count: true, url: recipient_count_admin_chapter_contact_path(@chapter), recipient_count_singular: t('admin.chapter_contacts.recipients_count.one'), recipient_count_plural: t('admin.chapter_contacts.recipients_count.other') }, aria: { live: 'polite' } }
      = t('admin.chapter_contacts.recipients_count', count: @recipient_count)
    .mb-3
      = form.label :audience, t('admin.chapter_contacts.audience'), class: 'form-label'
      = form.select :audience, options_for_select(ChapterContactAudience.options, @audience), {}, class: 'form-select', data: { chapter_contact_audience: true, contact_audience_field_map: ChapterContactAudience::FIELD_AUDIENCES.to_json, recipient_count_filter: true }
    .mb-3{ data: { contact_audience_fields: 'custom_list' } }
      %fieldset
        %legend.fs-6= t('admin.chapter_contacts.custom_list_legend')
        .chapter-contact-member-list
          = form.collection_check_boxes :member_ids, @chapter_members, :id, :full_name do |checkbox|
            .form-check
              = checkbox.check_box(class: 'form-check-input', data: { recipient_count_filter: true })
              = checkbox.label(class: 'form-check-label')
    .mb-3{ data: { contact_audience_fields: 'event_rsvp' } }
      .mb-3
        = form.label :event_id, t('admin.chapter_contacts.event'), class: 'form-label'
        = form.select :event_id, options_from_collection_for_select(@chapter_events, :id, :name, @event_id), { include_blank: t('admin.chapter_contacts.select_event') }, class: 'form-select', data: { no_chosen: true, recipient_count_filter: true }
      .mb-3
        = form.label :rsvp_status, t('admin.chapter_contacts.rsvp_status'), class: 'form-label'
        = form.select :rsvp_status, options_for_select(ChapterContactAudience.rsvp_status_options, @rsvp_status), { include_blank: t('admin.chapter_contacts.select_rsvp_status') }, class: 'form-select', data: { no_chosen: true, recipient_count_filter: true }
    .mb-3{ data: { contact_audience_fields: 'activity_period' } }
      = form.label :activity_months, t('admin.chapter_contacts.activity_period_label'), class: 'form-label'
      = form.select :activity_months, options_for_select(ChapterContactAudience.activity_period_options, @activity_months), {}, class: 'form-select', data: { no_chosen: true, recipient_count_filter: true }
    .mb-3
      = form.label :subject, class: 'form-label'
      = form.text_field :subject, class: 'form-control', required: true, value: @subject
    .mb-3
      = form.label :message, class: 'form-label'
      = form.text_area :message, class: 'form-control', rows: 8, required: true, value: @message
      .form-text= t('admin.chapter_contacts.message_html_hint')
    = form.submit t('admin.chapter_contacts.preview_recipients'), class: 'btn btn-primary'
