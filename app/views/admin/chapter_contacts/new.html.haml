.container.py-4
  %h1 Contact #{@chapter.name} members
  %p #{@recipient_count} recipients

  - if flash[:alert]
    .alert.alert-danger= flash[:alert]

  = form_with scope: :chapter_contact, url: preview_admin_chapter_contact_path(@chapter) do |form|
    .mb-3
      = form.label :audience, 'Audience', class: 'form-label'
      = form.select :audience, options_for_select([['All chapter members', 'all_members'], ['Chapter organisers', 'chapter_organisers'], ['Custom list', 'custom_list']], @audience), {}, class: 'form-select'
    .mb-3
      %fieldset
        %legend.fs-6 Select members for a custom list
        = form.collection_check_boxes :member_ids, @chapter_members, :id, :full_name do |checkbox|
          .form-check
            = checkbox.check_box(class: 'form-check-input')
            = checkbox.label(class: 'form-check-label')
    .mb-3
      = form.label :subject, class: 'form-label'
      = form.text_field :subject, class: 'form-control', required: true, value: @subject
    .mb-3
      = form.label :message, class: 'form-label'
      = form.text_area :message, class: 'form-control', rows: 8, required: true, value: @message
    = form.submit 'Preview recipients', class: 'btn btn-primary'
