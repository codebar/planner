- summary = event.pairing_summary(pairings)
.pairing-board{ id: 'pairing-board', data: { pairing_create_url: admin_event_pairings_path(event), pairing_sync_url: admin_event_pairings_path(event) } }
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-1
    .d-flex.flex-wrap.align-items-center.gap-2
      %h5.mb-0 Pairings
      - if summary.groups_count.positive?
        %span.badge.rounded-pill.bg-primary= pluralize(summary.groups_count, 'group')
        %span.badge.rounded-pill.bg-white.text-dark.border
          #{pluralize(summary.students_count, 'student')} · #{pluralize(summary.coaches_count, 'coach')}
        - if summary.waiting_count.positive?
          %span.badge.rounded-pill.pairing-badge--waiting #{summary.waiting_count} waiting
  %p.text-muted.small.mb-3
    Attendees auto-pair on check-in. Drag anyone onto a group to re-pair, or drop into the zone below to start a new group.

  .alert.alert-danger.py-2.px-3.small.d-none{ role: 'alert', data: { pairing_error: true } }

  - if pairings.empty?
    .pairing-empty-state.text-center.text-muted.py-4.px-3
      %i.fas.fa-user-friends.fa-lg.mb-2.d-block.opacity-50
      No one has checked in yet. Check in an attendee to start pairing.
  - else
    .row.d-none.d-md-flex.mb-2.px-2.pairing-section-header
      .col-md-6 Students
      .col-md-6 Coaches
    - pairings.each do |pairing|
      = render partial: 'admin/events/pairing_group', locals: { event:, pairing: }
    .pairing-unpair-zone{ data: { pairing_dropzone: 'unpair' } }
      %i.fas.fa-plus-circle.me-2
      Drop someone here to move them into a new solo group
