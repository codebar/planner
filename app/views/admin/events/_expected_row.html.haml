.expected-row{ data: { expected_row: true, state: 'expected', invitation_id: invitation.id, role: invitation.role, full_name: invitation.member.full_name } }
  .expected-row__pending.d-flex.justify-content-between.align-items-start.gap-2
    .min-w-0
      .d-flex.flex-wrap.align-items-center.gap-2
        = link_to invitation.member.full_name, admin_member_path(invitation.member), class: 'pairing-slot__name'
        - if MemberPresenter.new(invitation.member).newbie?
          %span.badge.rounded-pill.pairing-badge--newbie New attendee
      - if invitation.note.present?
        %p.pairing-slot__note.mb-0.mt-1= invitation.note
    .d-flex.align-items-center.gap-1.flex-shrink-0
      - if event.confirmation_required
        = button_to admin_event_invitation_check_in_path(event, invitation_id: invitation.id),
                    method: :post,
                    class: 'btn btn-sm btn-success',
                    form: { class: 'd-inline', data: { pairing_checkin_form: true } } do
          %i.fas.fa-check.me-1{ aria: { hidden: 'true' } }
          Check in
      = link_to admin_event_invitation_cancel_path(event, invitation),
                class: 'btn btn-sm btn-outline-secondary pairing-slot__action pairing-slot__action--cancel',
                method: :post,
                title: 'Cancel attendance',
                aria: { label: "Cancel attendance for #{invitation.member.full_name}" },
                data: { confirm: "Cancel attendance for #{invitation.member.full_name}?" } do
        %i.fas.fa-times{ aria: { hidden: 'true' } }
  .expected-row__settled.d-flex.justify-content-between.align-items-center.gap-2
    .min-w-0
      %span.fw-semibold.text-success
        %i.fas.fa-check-circle.me-1{ aria: { hidden: 'true' } }
        = invitation.member.full_name
      %p.mb-0.mt-1.small.text-success{ data: { settled_status: true } } Checked in
    .d-flex.align-items-center.gap-1.flex-shrink-0
      = button_to admin_event_invitation_check_in_path(event, invitation_id: invitation.id),
                  method: :delete,
                  class: 'btn btn-sm btn-outline-secondary',
                  title: 'Undo check-in',
                  form: { class: 'd-inline', data: { pairing_undo_form: true } } do
        Undo
      %button.btn.btn-sm.btn-outline-primary{ type: 'button', data: { pairing_jump_btn: true } }
        View ↓
