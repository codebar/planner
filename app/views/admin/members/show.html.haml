= render 'actions'
.container.py-4.py-lg-5
  .row
    .col-12.col-md-3
      = render 'profile'
    .col-12.col-md-9
      .row
        .col
          %ul.list-unstyled#actions
            - @actions.each do |action|
              %li.border-bottom.mb-3.pb-3= render action, action: action

      .row.d-flex.align-items-center
        .col-2.col-md-1
          %span.fa-stack.text-success
            %i.fas.fa-circle.fa-stack-2x
            %i.fas.fa-user-plus.fa-stack-1x.fa-inverse
        .col-9.col-md-11
          %strong Signed up
          = l(@member.created_at, format: :website_format)


      - if @member.upcoming_rsvps.any?
        .row
          .col
            %h3.mt-4 Upcoming RSVPs
            - @member.upcoming_rsvps.each do |invitation|
              = render EventPresenter.decorate(invitation.event), invitation: invitation
      .row.mt-4
        .col
          = link_to 'View all RSVPS', admin_member_events_path(@member), class: 'btn btn-primary btn-block'

      .row.mt-4
        .col
          %h3.mt-4 Activity
          = render Admin::Members::ActivityStripComponent.new(weeks: @activity_weeks)

          %ul.list-unstyled.activity-log.mt-3
            - @activities.group_by { |a| a.created_at.beginning_of_week.to_date }.each do |week_start, activities|
              %li
                %h5.mt-3
                  #{week_start.strftime('%G-W%V')}
                  %span.small.text-muted (week of #{week_start.strftime('%-d %b %Y')})
                %ul.list-unstyled
                  - activities.each do |activity|
                    %li.pb-2.mb-2
                      = activity.key.tr('.', ' ').humanize
                      - if (subject = activity_subject(activity))
                        %span.text-muted.ms-1
                          = t('admin.members.activity.for', subject: link_to(activity_subject_label(subject), [:admin, subject])).html_safe
                      %span.text-muted.ms-2= l(activity.created_at, format: :activity_log)
            - if @activities.empty?
              %li.text-muted No recorded activity yet
