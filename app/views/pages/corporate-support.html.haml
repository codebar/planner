            %p= t('pages.how_to_support_us.corporate_support.support_us_your_way.cards.volunteer.description')
            %p.mt-auto= link_to t('pages.how_to_support_us.corporate_support.support_us_your_way.cards.volunteer.link'), volunteer_path, class: 'btn btn-outline-primary'
