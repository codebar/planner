- title = local_assigns[:title] ? local_assigns[:title] : t("support_us_component.title")

.row.justify-content-center
  .col-12.col-md-7.text-center.mb-3
    %h2= title
    %p.my-4= t("support_us_component.description")

.row.justify-content-center
  .d-flex.col-sm-12.col-md-6.col-lg-3.text-center
    .card.mt-3.mt-lg-0.w-100.h-100
      .card-body.d-flex.flex-column
        %h5.card-title.mt-3.mb-3= t("support_us_component.donation_form.title")
        %p.card-text= t("support_us_component.donation_form.text")
        = link_to(t("support_us_component.donation_form.link"), t("services.donations"), class: "btn btn-primary mt-auto mb-3 align-self-center")
  .d-flex.col-sm-12.col-md-6.col-lg-3.text-center
    .card.mt-3.mt-lg-0.w-100.h-100
      .card-body.d-flex.flex-column
        %h5.card-title.mt-2.mb-3= t("support_us_component.fundraise.title")
        %p.card-text= t("support_us_component.fundraise.text")
        = link_to(t("support_us_component.fundraise.link"), "mailto:hello@codebar.io", class: "btn btn-primary mt-auto mb-3 align-self-center")
  .d-flex.col-sm-12.col-md-6.col-lg-3.text-center
    .card.mt-3.mt-lg-0.w-100.h-100
      .card-body.d-flex.flex-column
        %h5.card-title.mt-2.mb-3= t("support_us_component.corporate.title")
        %p.card-text= t("support_us_component.corporate.text")
        = link_to(t("support_us_component.corporate.link"), "mailto:hello@codebar.io", class: "btn btn-primary mt-auto mb-3 align-self-center")
  .d-flex.col-sm-12.col-md-6.col-lg-3.text-center
    .card.mt-3.mt-lg-0.w-100.h-100
      .card-body.d-flex.flex-column
        %h5.card-title.mt-2.mb-3= t("support_us_component.other.title")
        %p.card-text= t("support_us_component.other.text")
        = link_to(t("support_us_component.other.link"), "mailto:hello@codebar.io", class: "btn btn-primary mt-auto mb-3 align-self-center")
